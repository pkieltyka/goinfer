#version 450
layout(local_size_x = 1) in;
layout(std430, set = 0, binding = 0) readonly buffer Input { float values[]; } inputBuffer;
layout(std430, set = 0, binding = 1) writeonly buffer Output { float values[]; } outputBuffer;
layout(push_constant) uniform Params { uint addend; } params;
void main() {
    uint i = gl_GlobalInvocationID.x;
    outputBuffer.values[i] = inputBuffer.values[i] + float(params.addend);
}
