#version 450
layout(local_size_x=64) in;
layout(std430,binding=0) buffer X {float x[];};
layout(std430,binding=1) readonly buffer Cos {float cs[];};
layout(std430,binding=2) readonly buffer Sin {float sn[];};
layout(std430,binding=3) readonly buffer Segments {vec2 bounds[];};
layout(push_constant) uniform Shape {uint pairs, heads, dim;} p;
void main() {
    uint i=gl_GlobalInvocationID.x+gl_WorkGroupID.y*gl_NumWorkGroups.x*64;
    if (i>=p.pairs) return;
    uint halfDim=p.dim/2, head=i/halfDim, d=i%halfDim, row=head/p.heads;
    uint j=(row-uint(bounds[row].x))*halfDim+d, k=head*p.dim+d;
    float a=x[k], b=x[k+halfDim];
    x[k]=a*cs[j]-b*sn[j];
    x[k+halfDim]=b*cs[j]+a*sn[j];
}
