#version 450
layout(local_size_x=64) in;
layout(std430,binding=0) readonly buffer In {float src[];};
layout(std430,binding=1) readonly buffer Weight {float weight[];};
layout(std430,binding=2) writeonly buffer Out {float dst[];};
layout(push_constant) uniform Shape {uint rows,width; float epsilon;} p;
shared float squares[64];
void main() {
    uint row=gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x;
    if (row>=p.rows) return;
    uint lane=gl_LocalInvocationID.x;
    uint base=row*p.width;
    float sum=0.0;
    for (uint i=lane; i<p.width; i+=64) {float v=src[base+i]; sum+=v*v;}
    squares[lane]=sum;
    barrier();
    for (uint step=32; step>0; step/=2) {
        if (lane<step) squares[lane]+=squares[lane+step];
        barrier();
    }
    float inv=inversesqrt(squares[0]/float(p.width)+p.epsilon);
    // Each lane owns its columns throughout, including when src and dst alias.
    for (uint i=lane; i<p.width; i+=64) dst[base+i]=src[base+i]*inv*weight[i];
}
