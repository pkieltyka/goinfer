#version 450

layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Scores { float scores[]; };
layout(push_constant) uniform Shape {
    uint queryStart;
    uint blockRows;
    uint heads;
    uint kvHeads;
    uint headDim;
    uint keyStart;
    uint keys;
    uint sequenceStart;
    uint radius;
} p;

shared float partial[64];

void main() {
    uint row = gl_WorkGroupID.x;
    uint head = gl_WorkGroupID.y;
    if (row >= p.blockRows || head >= p.heads) {
        return;
    }
    uint query = p.queryStart + row;
    uint lane = gl_LocalInvocationID.x;
    uint first = max(p.keyStart, query - min(query, p.radius)) - p.keyStart;
    uint end = min(p.keyStart + p.keys, query + p.radius + 1u) - p.keyStart;
    uint base = (head * p.blockRows + row) * p.keys;

    // Key ownership is relative to the sequence, even when this tile clips
    // earlier keys. This preserves the singleton summation order.
    uint firstOwned = (p.sequenceStart + lane - p.keyStart) & 63u;
    float peak = uintBitsToFloat(0xff7fffffu);
    for (uint key = firstOwned; key < p.keys; key += 64u) {
        if (key >= first && key < end) {
            peak = max(peak, scores[base + key]);
        }
    }
    partial[lane] = peak;
    barrier();
    for (uint stride = 32u; stride > 0u; stride /= 2u) {
        if (lane < stride) {
            partial[lane] = max(partial[lane], partial[lane + stride]);
        }
        barrier();
    }
    float rowMax = partial[0];
    barrier();

    float total = 0.0;
    for (uint key = firstOwned; key < p.keys; key += 64u) {
        float value = 0.0;
        if (key >= first && key < end) {
            value = exp(scores[base + key] - rowMax);
        }
        scores[base + key] = value;
        total += value;
    }
    partial[lane] = total;
    barrier();
    for (uint stride = 32u; stride > 0u; stride /= 2u) {
        if (lane < stride) {
            partial[lane] += partial[lane + stride];
        }
        barrier();
    }
    float inverse = 1.0 / partial[0];
    for (uint key = firstOwned; key < p.keys; key += 64u) {
        if (key >= first && key < end) {
            scores[base + key] *= inverse;
        }
    }
}
