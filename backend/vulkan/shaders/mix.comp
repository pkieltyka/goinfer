#version 450
layout(local_size_x=64) in;
layout(std430,binding=0) buffer Out {float dst[];};
layout(std430,binding=1) readonly buffer In {float src[];};
layout(push_constant) uniform Shape {uint count, mode; float scale; uint width, layers, layer;} p;
float gelu(float x) {
    float arg=0.7978845608*(x+0.044715*x*x*x);
    // Saturate before the driver's tanh reaches its exponential overflow range.
    if (arg>10.0) return x;
    if (arg< -10.0) return 0.0;
    return 0.5*x*(1.0+tanh(arg));
}
void main() {
    uint i=gl_GlobalInvocationID.x+gl_WorkGroupID.y*gl_NumWorkGroups.x*64;
    if (i>=p.count) return;
    if (p.mode==0) dst[i]*=p.scale;
    else if (p.mode==1) dst[i]=(dst[i]+src[i])*p.scale;
    else if (p.mode==2) dst[i]=gelu(dst[i])*src[i];
    else {
        uint j=((i/p.width)*p.layers+p.layer)*p.width+i%p.width;
        dst[i]=gelu(dst[i])*src[j];
    }
}
